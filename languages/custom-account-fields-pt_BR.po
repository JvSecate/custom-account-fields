msgstr "URL"

msgid "CEP"
msgstr "CEP"

msgid "Custom regex"
msgstr "Regex personalizado"

msgid "Configure account fields for registration, account editing, and admin user profiles."
msgstr "Configure campos de conta para registro, edição de conta e perfis de usuário no admin."

msgid "Fields saved successfully. Missing user values were filled with each field default."
msgstr "Campos salvos com sucesso. Valores ausentes dos usuários foram preenchidos com o padrão de cada campo."

msgid "Fields imported successfully. Missing user values were filled with each field default."
msgstr "Campos importados com sucesso. Valores ausentes dos usuários foram preenchidos com o padrão de cada campo."

msgid "The JSON import failed. Check that the file is valid JSON and contains field definitions."
msgstr "A importação do JSON falhou. Verifique se o arquivo é um JSON válido e contém definições de campos."

msgid "Add field"
msgstr "Adicionar campo"

msgid "Save fields"
msgstr "Salvar campos"

msgid "Fields not enabled for registration or account editing stay private to the admin user profile UI."
msgstr "Campos não habilitados para registro ou edição de conta permanecem privados na interface de perfil de usuário do admin."

msgid "Import fields from JSON"
msgstr "Importar campos de JSON"

msgid "Import replaces the current field configuration. Existing user values are not overwritten; missing values receive the imported default value."
msgstr "A importação substitui a configuração atual de campos. Valores existentes dos usuários não são sobrescritos; valores ausentes recebem o valor padrão importado."

msgid "Import JSON"
msgstr "Importar JSON"

msgid "Remove this field?"
msgstr "Remover este campo?"

msgid "(new field)"
msgstr "(novo campo)"

msgid "Drag"
msgstr "Arrastar"

msgid "Remove field"
msgstr "Remover campo"

msgid "Key (meta key)"
msgstr "Chave (meta key)"

msgid "Unique identifier used to save the user meta value. Example: is_affiliated."
msgstr "Identificador único usado para salvar o valor no meta do usuário. Exemplo: is_affiliated."

msgid "Label"
msgstr "Rótulo"

msgid "Affiliated"
msgstr "Afiliado"

msgid "Type"
msgstr "Tipo"

msgid "Default value"
msgstr "Valor padrão"

msgid "Applied to new users and to existing users that do not yet have this meta key. For checkboxes, use 1 or 0."
msgstr "Aplicado a novos usuários e a usuários existentes que ainda não possuem esta chave meta. Para checkboxes, use 1 ou 0."

