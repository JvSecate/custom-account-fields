msgid "%s must be a valid phone number (example: (11) 91234-5678)."
msgstr "%s deve ser um número de telefone válido (ex: (11) 91234-5678)."

msgid "%s must be a valid CPF."
msgstr "%s deve ser um CPF válido."

msgid "%s must be a valid CNPJ."
msgstr "%s deve ser um CNPJ válido."

msgid "%s must be a valid CPF or CNPJ."
msgstr "%s deve ser um CPF ou CNPJ válido."

msgid "%s must be a valid email address."
msgstr "%s deve ser um e-mail válido."

msgid "%s must be a valid URL."
msgstr "%s deve ser uma URL válida."

msgid "%s must be a valid postal code (example: 01310-100)."
msgstr "%s deve ser um CEP válido (ex: 01310-100)."

msgid "%s has an invalid format."
msgstr "%s possui um formato inválido."

msgid "%s is invalid."
msgstr "%s é inválido."

msgid "Account Fields"
msgstr "Campos da Conta"

msgid "You do not have permission to manage account fields."
msgstr "Você não tem permissão para gerenciar os campos da conta."

msgid "None"
msgstr "Nenhuma"

msgid "Brazilian phone"
msgstr "Telefone BR"

msgid "CPF"
msgstr "CPF"

msgid "CNPJ"
msgstr "CNPJ"

